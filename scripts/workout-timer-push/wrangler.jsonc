{
  "name": "bodymake-test-rest-notifications",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-04",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "REST_TIMERS", "class_name": "WorkoutRestTimer" }]
  },
  "migrations": [{ "tag": "test-rest-v1", "new_sqlite_classes": ["WorkoutRestTimer"] }]
}

{
  "name": "helthapp",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=10 <11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:test": "node scripts/run-test-environment.mjs dev",
    "dev:shared-test": "node scripts/shared-test-environment.mjs dev",
    "build": "next build --webpack",
    "build:test": "node scripts/run-test-environment.mjs build",
    "build:shared-test": "node scripts/shared-test-environment.mjs build",
    "test:shared-test": "node --test scripts/test-shared-test-runtime.mjs scripts/test-shared-test-build-config.mjs",
    "test:shared-test-build": "node scripts/test-environment-build.mjs --shared",
    "start": "next start",
    "lint": "eslint",
    "generate:food-data": "python3 scripts/generate-mext-food-library.py",
    "generate:curated-food-data": "node --max-old-space-size=2048 scripts/generate-food-library.mjs",
    "validate:food-data": "node scripts/validate-food-library.mjs",
    "test:food-catalog": "node scripts/test-food-catalog.mjs",
    "test:static-ui": "node scripts/test-static-ui.mjs",
    "test:mobile-viewport": "node scripts/test-mobile-viewport.mjs",
    "test:workout-split": "node --experimental-strip-types --test scripts/test-workout-split.mjs",
    "test:muscle-activity": "node --experimental-strip-types --test scripts/test-muscle-activity.mjs",
    "test:exercise-shorts": "node --experimental-strip-types --test scripts/test-exercise-short-videos.mjs",
    "test:environment-build": "node scripts/test-environment-build.mjs",
    "test:team-runtime": "node --test scripts/test-team-runtime.mjs",
    "test:photo-submission": "node --test scripts/food-ai/submission-client.test.mjs scripts/food-ai/public-photo-flow.test.mjs scripts/food-ai/jpeg-metadata.test.mjs scripts/food-ai/streaming-upload.test.mjs",
    "test:food-ai:model-cache": "node --test scripts/food-ai/streaming/model-cache.test.mjs",
    "food-ai:learn": "node scripts/food-ai/learn.mjs",
    "food-ai:launcher": "PYTHONDONTWRITEBYTECODE=1 python3 -B scripts/food-ai/streaming/launcher.py",
    "food-ai:stream:check": "PYTHONDONTWRITEBYTECODE=1 python3 -B scripts/food-ai/streaming/pipeline.py --preflight",
    "test:food-ai:stream": "PYTHONDONTWRITEBYTECODE=1 python3 -B -m unittest discover -s scripts/food-ai/streaming -p 'test_*.py'",
    "food-ai:collect": "node scripts/food-ai/collect-commons.mjs",
    "food-ai:collect:nutrition": "node scripts/food-ai/collect-nutrition5k.mjs",
    "food-ai:archive": "node scripts/food-ai/drive-archive.mjs",
    "food-ai:agent": "node scripts/food-ai/agent.mjs",
    "food-ai:review": "node scripts/food-ai/review-queue.mjs",
    "food-ai:review:apply": "node scripts/food-ai/record-review.mjs",
    "test:food-ai": "node --test scripts/food-ai/*.test.mjs",
    "test:aws": "node --test backend/*.test.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "firebase": "^12.19.0",
    "next": "16.3.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "picomatch": "^4.0.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}

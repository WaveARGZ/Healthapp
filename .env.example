# Set all five values together to enable AWS account mode. Never put AWS secrets here.
NEXT_PUBLIC_BODYMAKE_AUTH_DOMAIN=
NEXT_PUBLIC_BODYMAKE_CLIENT_ID=
NEXT_PUBLIC_BODYMAKE_API_URL=
NEXT_PUBLIC_BODYMAKE_CALLBACK_URL=http://localhost:3000/auth/callback/
NEXT_PUBLIC_BODYMAKE_LOGOUT_URL=http://localhost:3000/bodymake
# Set to true only after the Google identity provider is enabled in Cognito.
NEXT_PUBLIC_BODYMAKE_GOOGLE_SIGN_IN_ENABLED=false

# Optional: only use after creating a separate, non-production AWS backend.
# `npm run dev:test` works with all values empty and stores data on this device.
NEXT_PUBLIC_BODYMAKE_TEST_AUTH_DOMAIN=
NEXT_PUBLIC_BODYMAKE_TEST_CLIENT_ID=
NEXT_PUBLIC_BODYMAKE_TEST_API_URL=
NEXT_PUBLIC_BODYMAKE_TEST_CALLBACK_URL=http://localhost:3001/auth/callback/
NEXT_PUBLIC_BODYMAKE_TEST_LOGOUT_URL=http://localhost:3001/bodymake
NEXT_PUBLIC_BODYMAKE_TEST_GOOGLE_SIGN_IN_ENABLED=false
NEXT_PUBLIC_BODYMAKE_TEST_TRAINING_ENDPOINT=

# Optional override for the shared food-correction Apps Script URL.
# Firebase production uses the public default in lib/storage/google-drive-settings.ts.
NEXT_PUBLIC_BODYMAKE_TRAINING_ENDPOINT=

# Firebase migration (opt-in). Use a new Spark project; never set a billing account.
# Keep this empty until the project and Firestore rules are ready.
NEXT_PUBLIC_BODYMAKE_BACKEND=
NEXT_PUBLIC_BODYMAKE_FIREBASE_API_KEY=
NEXT_PUBLIC_BODYMAKE_FIREBASE_AUTH_DOMAIN=
# Optional: on touch devices, use this same-origin Firebase Hosting domain for redirect login.
# Google OAuth must allow https://<that-domain>/__/auth/handler as a redirect URI.
NEXT_PUBLIC_BODYMAKE_FIREBASE_MOBILE_AUTH_DOMAIN=
NEXT_PUBLIC_BODYMAKE_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_BODYMAKE_FIREBASE_APP_ID=

# Optional isolated Firebase test project. `npm run dev:test` never reads production Firebase values.
NEXT_PUBLIC_BODYMAKE_TEST_BACKEND=
NEXT_PUBLIC_BODYMAKE_TEST_FIREBASE_API_KEY=
NEXT_PUBLIC_BODYMAKE_TEST_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_BODYMAKE_TEST_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_BODYMAKE_TEST_FIREBASE_APP_ID=

# Set all five values together to enable AWS account mode. Never put AWS secrets here.
NEXT_PUBLIC_BODYMAKE_AUTH_DOMAIN=
NEXT_PUBLIC_BODYMAKE_CLIENT_ID=
NEXT_PUBLIC_BODYMAKE_API_URL=
NEXT_PUBLIC_BODYMAKE_CALLBACK_URL=http://localhost:3000/auth/callback/
NEXT_PUBLIC_BODYMAKE_LOGOUT_URL=http://localhost:3000/
# Set to true only after the Google identity provider is enabled in Cognito.
NEXT_PUBLIC_BODYMAKE_GOOGLE_SIGN_IN_ENABLED=false

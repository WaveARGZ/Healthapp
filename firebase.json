{
  "hosting": {
    "site": "healthapp-14a3f",
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "trailingSlash": true,
    "headers": [
      {
        "regex": "^/(food-photo|meals)(/.*|\\.html)?$",
        "headers": [{ "key": "Cache-Control", "value": "no-store" }]
      }
    ],
    "redirects": [
      { "source": "/", "destination": "/bodymake/", "type": 302 }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
